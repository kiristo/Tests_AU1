@inherits LayoutComponentBase

<FluentLayout>
    <FluentHeader>
        BlazorFluentCMS
    </FluentHeader>
    <FluentStack Class="main" Orientation="Orientation.Horizontal" Style="width: 100%;">
        <NavMenu />
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    <FluentFooter>
        <a href="https://www.fluentui-blazor.net" target="_blank">Documentation and demos</a>
        <FluentSpacer />
        <a href="https://learn.microsoft.com/en-us/aspnet/core/blazor" target="_blank">About Blazor</a>
    </FluentFooter>
</FluentLayout>
